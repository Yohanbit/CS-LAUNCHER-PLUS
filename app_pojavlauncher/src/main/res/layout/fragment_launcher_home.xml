<?xml version="1.0" encoding="utf-8"?>
<!-- Original, compact home: account, selected instance, play, library and tools.
     The vertical scroll keeps every action reachable on short landscape screens. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101317"
    tools:ignore="HardcodedText">

    <!-- Retained IDs for compatibility; Home no longer renders an animated stage. -->
    <ImageView android:id="@+id/lh_bg_a" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:contentDescription="@null" />
    <ImageView android:id="@+id/lh_bg_b" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:contentDescription="@null" />
    <android.opengl.GLSurfaceView android:id="@+id/lh_player" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/lh_hero_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/lh_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/lh_brand_cluster"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <FrameLayout android:id="@+id/lh_brand_mark" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="8dp">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/unamed_launcher_icon" android:contentDescription="@null" />
                        </FrameLayout>
                        <TextView
                            android:id="@+id/lh_brand_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/app_name"
                            android:textColor="#F2F4F7"
                            android:textSize="21sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Minecraft Java Edition" android:textColor="#9DA7B4" android:textSize="12sp" android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lh_account_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView android:id="@+id/lh_account_head" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_profile_player" android:scaleType="centerCrop" android:contentDescription="@null" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="vertical">
                        <TextView android:id="@+id/lh_account_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="88dp" android:maxLines="1" android:ellipsize="end" android:text="Account" android:textColor="#F2F4F7" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:id="@+id/lh_account_type" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOCAL" android:textColor="#9DA7B4" android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lh_instance_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#1B2027">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SELECTED INSTANCE" android:textColor="#9DA7B4" android:textSize="11sp" android:letterSpacing="0.06" />
                <LinearLayout
                    android:id="@+id/lh_instance_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="8dp">
                        <TextView android:id="@+id/lh_instance_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:text="Create your first instance" android:textColor="#F2F4F7" android:textSize="23sp" android:textStyle="bold" />
                        <TextView android:id="@+id/lh_instance_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:maxLines="2" android:ellipsize="end" android:text="Choose a Minecraft version to get started" android:textColor="#ADB7C5" android:textSize="12sp" />
                    </LinearLayout>
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="12dp" android:src="@drawable/ic_chevron_down" app:tint="#ADB7C5" android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout android:id="@+id/lh_launch_specs" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp" android:layout_marginBottom="12dp">
                    <ImageView android:id="@+id/lh_spec_java_icon" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_settings_java" app:tint="#9DA7B4" android:contentDescription="@null" />
                    <TextView android:id="@+id/lh_spec_java_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Java" android:textColor="#ADB7C5" android:textSize="12sp" />
                    <ImageView android:id="@+id/lh_spec_ram_icon" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="16dp" android:src="@drawable/ic_settings_performance" app:tint="#9DA7B4" android:contentDescription="@null" />
                    <TextView android:id="@+id/lh_spec_ram_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="RAM" android:textColor="#ADB7C5" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/lh_launch_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
                    <net.kdt.pojavlaunch.ui.PremiumPlayButtonView
                        android:id="@+id/lh_launch_button"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:contentDescription="Play Minecraft">
                        <!-- First child must be the icon: the existing button updates it for Stop. -->
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center_vertical|start" android:layout_marginStart="20dp" android:src="@drawable/ic_play_arrow" app:tint="#0E0E11" android:contentDescription="@null" />
                        <TextView android:id="@+id/lh_launch_label" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="48dp" android:paddingEnd="16dp" android:gravity="center" android:text="Play" android:textColor="#0E0E11" android:textSize="16sp" android:textStyle="bold" />
                    </net.kdt.pojavlaunch.ui.PremiumPlayButtonView>
                    <FrameLayout android:id="@+id/lh_edit_btn" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="12dp" android:background="?android:attr/selectableItemBackground" android:contentDescription="Edit selected instance" android:clickable="true" android:focusable="true">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_edit_profile" app:tint="#C9D2DF" android:contentDescription="@null" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/lh_dl_pill" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <FrameLayout android:id="@+id/lh_dl_icon_wrap" android:layout_width="24dp" android:layout_height="24dp">
                            <ImageView android:id="@+id/lh_dl_icon" android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center" android:src="@drawable/ic_download" app:tint="#A9C7BC" android:contentDescription="@null" />
                        </FrameLayout>
                        <TextView android:id="@+id/lh_dl_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Preparing…" android:textColor="#F2F4F7" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
                        <TextView android:id="@+id/lh_dl_percent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="0%" android:textColor="#ADB7C5" android:textSize="12sp" />
                    </LinearLayout>
                    <ProgressBar android:id="@+id/lh_dl_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp" android:max="100" android:progress="0" android:progressTint="#A9C7BC" android:progressBackgroundTint="#343D48" />
                    <TextView android:id="@+id/lh_dl_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:maxLines="2" android:ellipsize="end" android:textColor="#9DA7B4" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Your instances" android:textColor="#F2F4F7" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/lh_new_instance" android:layout_width="wrap_content" android:layout_height="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:gravity="center" android:text="+ New" android:textColor="#A9C7BC" android:textSize="13sp" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:contentDescription="Create instance" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/lh_library" android:layout_width="match_parent" android:layout_height="72dp" android:clipToPadding="false" android:overScrollMode="never" android:nestedScrollingEnabled="false" />
            <TextView android:id="@+id/lh_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:paddingBottom="16dp" android:visibility="gone" android:text="No instances yet. Create one above to begin." android:textColor="#9DA7B4" android:textSize="13sp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" android:text="Tools" android:textColor="#9DA7B4" android:textSize="12sp" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:overScrollMode="never">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/lh_tool_skins" android:layout_width="88dp" android:layout_height="48dp" android:gravity="center" android:text="Skins" android:textColor="#D1D8E2" android:textSize="13sp" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/lh_tool_controls" android:layout_width="88dp" android:layout_height="48dp" android:gravity="center" android:text="Controls" android:textColor="#D1D8E2" android:textSize="13sp" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/lh_tool_runtime" android:layout_width="88dp" android:layout_height="48dp" android:gravity="center" android:text="Java" android:textColor="#D1D8E2" android:textSize="13sp" android:contentDescription="Java runtimes" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/lh_tool_cursor" android:layout_width="88dp" android:layout_height="48dp" android:gravity="center" android:text="Cursor" android:textColor="#D1D8E2" android:textSize="13sp" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/lh_tool_settings" android:layout_width="88dp" android:layout_height="48dp" android:gravity="center" android:text="Settings" android:textColor="#D1D8E2" android:textSize="13sp" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
